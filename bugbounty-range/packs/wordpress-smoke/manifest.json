      ]
    }
  ],
  "scenarios": [
    {
      "scenario_id": "wp-smoke-readiness",
      "description": "Wait for HTTP 200 on wordpress-smoke-001 via IAP-tunneled SSH; verify wp core is-installed.",
      "steps": [
        {
          "kind": "readiness",
          "node_ref": "wordpress-smoke-001"
        }
      ]
    }
  ],
  "evidence_sources": [
    {
      "node_ref": "wordpress-smoke-001",
      "path": "/var/log/bbr/bootstrap.log",
      "kind": "log"
    },
    {
      "node_ref": "wordpress-smoke-001",
      "path": "/var/lib/bbr/wordpress-ready",
      "kind": "file"
    }
  ],
  "ttl": {
