{
  "pack_id": "wordpress-smoke",
  "version": "0.4.0",
  "description": "Phase 4.0 wordpress-smoke pack (single-node raw_v m, controlled bootstrap via GCS-Tarball + Minisign). Lab-VM pulls a SHA-256+Minisign-verified artifact, installs WordPress with local MariaDB, runs an HTTP 200 healthcheck. No Cloud NAT, no Artifact Registry, no public IP. Bootstrap is gated by exit codes 30-39.",
  "topology": {
    "nodes": [
      {
        "node_id": "wordpress-smoke-001",
        "role": "vulnerable",
        "driver": "raw_vm",
        "machine_type": "e2-small",
        "disk_type": "pd-standard",
        "disk_size_gb": 20,
        "base_image": {
          "self_link": "projects/your-lab-name-your-researcher-handle/global/images/bbr-debian-12-bootstrap-tools-20260727-v2"
        },
        "exposed_private_services": [
          {
            "name": "http",
            "port": 80,
            "protocol": "tcp"
          }
        ],
        "readiness_checks": [
          {
            "type": "http",
            "port": 80,
            "path": "/"
          },
          {
            "type": "command",
            "command": "wp --allow-root --path=/var/www/html core is-installed"
          }
        ],
        "lifecycle_hooks": {
          "pre_create": "provisioning/preflight.sh",
          "post_create": "provisioning/bootstrap.sh",
          "pre_destroy": "provisioning/rollback.sh",
          "post_destroy": "provisioning/post_destroy.sh"
        },
        "driver_payload": {
          "service_account_id": "bbr-lab-wordpress-smoke-001",
          "internal_ip": "10.200.2.10",
          "ttl_max_lifetime_seconds": 28800,
          "ttl_idle_timeout_seconds": 1800,
