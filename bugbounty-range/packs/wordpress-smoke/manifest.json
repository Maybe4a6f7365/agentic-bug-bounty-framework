          "bootstrap_artifact_sha256": "5ab046c3da9cb3e43d2f41953048df3a50fc903dec77a565c973841c462d48d4",
          "supported_platform": "projects/your-lab-name-your-researcher-handle/global/images/bbr-debian-12-bootstrap-tools-20260727-v2",
          "bootstrap_version": "6.8.2-r4",
          "wordpress_version": "6.8.2",
          "git_commit": "8a0c91e7528f8ae8c7acc57c69f0c23d2724010b",
