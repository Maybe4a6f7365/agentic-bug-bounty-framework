{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes.bbr/schemas/scenario.schema.json",
  "title": "BugBountyRange Scenario",
  "description": "A scenario describes a sequence of lab-local actions whose results will be captured by the evidence engine and compared by the differential engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "steps"],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "description": { "type": "string" },
    "timeout": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
    "follow_redirects": { "type": "boolean" },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/http_step" },
          { "$ref": "#/definitions/tcp_step" },
          { "$ref": "#/definitions/shell_step" },
          { "$ref": "#/definitions/readiness_step" },
          { "$ref": "#/definitions/capture_step" }
        ]
      }
    }
  },
  "definitions": {
    "http_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "destination_ref", "method", "path"],
      "properties": {
        "kind": { "const": "http" },
        "destination_ref": { "type": "string" },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE", "HEAD", "PATCH", "OPTIONS"] },
        "path": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": { "type": "string" },
        "expected_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "capture_response": { "type": "boolean" }
      }
    },
    "tcp_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "destination_ref", "data"],
      "properties": {
        "kind": { "const": "tcp" },
        "destination_ref": { "type": "string" },
        "data": { "type": "string" },
        "capture_response": { "type": "boolean" }
      }
    },
    "shell_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "script_ref"],
      "properties": {
        "kind": { "const": "shell" },
        "script_ref": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "readiness_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_ref"],
      "properties": {
        "kind": { "const": "readiness" },
        "node_ref": { "type": "string" }
      }
    },
    "capture_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_ref", "path"],
      "properties": {
        "kind": { "const": "capture" },
        "node_ref": { "type": "string" },
        "path": { "type": "string" },
        "mode": { "enum": ["log", "file", "command_output"] }
      }
    }
  }
}